{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "toetscijfers-www-local",
  "main": "index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "production": {
      "name": "toetscijfers-www",
      "routes": [{ "pattern": "www.toetscijfers.nl", "custom_domain": true }],
    },
  },
}

{
  "name": "toetscijfers",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "test": "node --test",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:a11y": "playwright test",
    "deploy:test": "wrangler deploy --env test",
    "deploy:www": "wrangler deploy --config www/wrangler.jsonc --env production"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "knip": "6.48.0",
    "oxfmt": "0.79.0",
    "wrangler": "4.166.0"
  }
}
